# orbit-crank — MAINNET environment (copy to /etc/orbit-crank/orbit-crank-mainnet.env,
# chmod 600, owned by root; read by orbit-crank-mainnet.service).
# Launch runbook: docs/runbooks/mainnet-launch.md. The devnet keeper keeps
# running beside this one with /etc/orbit-crank/orbit-crank.env.

# ── cluster ─────────────────────────────────────────────────────────────
# Selects the MAINNET program id in the SDK and enables the startup guards
# (an explicit mainnet RPC and a keeper key are required).
ORB_CLUSTER=mainnet
# A paid mainnet endpoint. Never a devnet URL (refused at startup).
CRANK_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
CRANK_COMMITMENT=confirmed
# Handed to third-party Switchboard oracle gateways for reveals — NEVER the
# paid URL above (it would leak the key). Default: the public mainnet RPC.
#CRANK_GATEWAY_RPC_URL=https://api.mainnet-beta.solana.com
# Switchboard crossbar: the crank's default (crossbar.switchboardlabs.xyz)
# serves mainnet too; the SDK's own default host no longer resolves.
#CRANK_SB_CROSSBAR_URL=https://crossbar.switchboardlabs.xyz

# ── keeper identity: the orb-keeper key from ~/.config/orb/mainnet ──────
CRANK_KEYPAIR_PATH=/etc/orbit-crank/keeper-mainnet.json

# ── separate state + health port, so both keepers coexist ───────────────
CRANK_STATE_DIR=/opt/orbit-crank/apps/crank/var-mainnet
CRANK_HEALTHZ_PORT=8081

# ── fees: mainnet inclusion is not free ─────────────────────────────────
# Start modest; raise if transactions land slowly under congestion.
CRANK_PRIORITY_FEE_MICROLAMPORTS=10000
# Follow the network (AUDIT C-8): p75 of recent fees on the written
# accounts, clamped to [the floor above, this cap].
CRANK_PRIORITY_FEE_MAX_MICROLAMPORTS=500000
CRANK_COMPUTE_UNIT_LIMIT=400000

# ── behaviour (same as devnet unless noted) ─────────────────────────────
CRANK_POLL_INTERVAL_MS=10000
CRANK_RPC_PACE_MS=150
CRANK_AUTO_DEPOSIT_ENABLED=1
# Rolls an expired empty window only while an auto-play escrow is armed.
CRANK_IDLE_ROLL_SECS=15
CRANK_CLAIM_FOR_WINNERS=1
CRANK_MIN_KEEPER_BALANCE_SOL=0.1
CRANK_LOG_LEVEL=info
