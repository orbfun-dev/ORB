# orbit-crank-mainnet — the MAINNET keeper (systemd unit). Runs beside the
# devnet orbit-crank.service from the same workspace tree; separate env,
# keeper key, state dir and health port (see .env.mainnet.example).
#
# Install:  sudo cp apps/crank/orbit-crank-mainnet.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now orbit-crank-mainnet
#
# ExecStart points at apps/crank/dist/main.js inside the deployed WORKSPACE
# tree (not a flattened /opt/orbit-crank/dist): the crank consumes the
# workspace SDK and the hoisted node_modules tree, resolves its version
# from ../package.json, and anchors its state dir to the working directory
# — a flattened tree would break all three.
#
# Full operations runbook: docs/runbooks/crank-ops.md

[Unit]
Description=Orbit Jackpot autonomous keeper (crank) — MAINNET
Documentation=file:///opt/orbit-crank/docs/runbooks/crank-ops.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orbit
Group=orbit
WorkingDirectory=/opt/orbit-crank/apps/crank
EnvironmentFile=/etc/orbit-crank/orbit-crank-mainnet.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5

# Stdout/stderr JSON logs land in journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orbit-crank-mainnet

# Sandbox: the keeper needs the network, its state dir, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/orbit-crank/apps/crank/var-mainnet

[Install]
WantedBy=multi-user.target
