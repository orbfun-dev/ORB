# orbit-crank environment template (copy to /etc/orbit-crank/orbit-crank.env
# on the droplet, or export before `npm run dev:crank` locally).
# Every variable is optional — the defaults target Solana Devnet.

# ── cluster ─────────────────────────────────────────────────────────────
# Public devnet RPC by default. Point at a paid/free private endpoint for
# production-grade reliability; 429-aware backoff is built in either way.
CRANK_RPC_URL=https://api.devnet.solana.com
# confirmed (default) | finalized — everything the keeper does is safe at
# confirmed; the create CPI's 512-slot ALT window actually demands it.
CRANK_COMMITMENT=confirmed

# ── keeper identity (REQUIRED in production — one of the two) ───────────
# solana-cli JSON keypair file (chmod 600):
CRANK_KEYPAIR_PATH=/etc/orbit-crank/keeper.json
# …or the raw 64-byte secret key, base58:
#CRANK_KEYPAIR_BASE58=

# ── loop timing ─────────────────────────────────────────────────────────
# Polling floor between evaluation ticks (WS wakeups arrive sooner).
CRANK_POLL_INTERVAL_MS=10000
# Set to 0 to disable WebSocket subscriptions (polling only).
CRANK_WS_ENABLED=1
# Minimum gap between RPC calls — keeps the public-RPC rate ceiling happy.
CRANK_RPC_PACE_MS=350
# Cap for the exponential 429 backoff (base 600 ms, doubling).
CRANK_MAX_BACKOFF_MS=30000

# ── idle behaviour (Phase 12: zero idle burn) ───────────────────────────
# While the active round is Open and EMPTY the keeper has nothing to do
# (the program rolls the window in place on the first bet), so the poll
# floor doubles each quiet tick up to this ceiling. Any action, tick
# error, or WebSocket wake (a deposit) restores the active floor at once.
#   10s floor → 20s → 40s → 80s → 120s (capped).
CRANK_IDLE_POLL_MAX_MS=120000
# 0 (default) = the keeper sends literally NOTHING while idle. Otherwise:
# once an empty expired round's end_ts is this many seconds in the past,
# send ONE lock_round window roll so the UI countdown doesn't show a
# window that died hours ago (costs one base fee per interval).
CRANK_IDLE_ROLL_SECS=0

# ── randomness ──────────────────────────────────────────────────────────
# Switchboard crossbar used to pick the commit oracle (https only). The
# SDK's built-in host, crossbar.switchboard.xyz, no longer resolves; its
# fallback added ~11 s to every settle. This default answers in ~3 s.
CRANK_SB_CROSSBAR_URL=https://crossbar.switchboardlabs.xyz

# ── transaction tuning ──────────────────────────────────────────────────
# Priority fee in micro-lamports per CU (0 = none; devnet needs none).
CRANK_PRIORITY_FEE_MICROLAMPORTS=0
# Omit to let the runtime estimate; reveal/settle benefit from ~200k.
#CRANK_COMPUTE_UNIT_LIMIT=200000

# ── operational safety ──────────────────────────────────────────────────
# Alert (warn log + degraded /healthz) when the keeper wallet drops below
# this. Phase 12 economics: idle burn is ZERO (empty rounds roll in place;
# the keeper sends nothing), round rents round-trip at close (rent_payer
# reciprocity), and each settled round tips the keeper — so the floor only
# needs to cover a burst of settle-pipeline gas, not rent churn. 0.05 SOL
# ≈ 10 funded settle pipelines of headroom. Each AUTO-DEPOSIT is +tip −
# fee for the keeper (escrow reimburses entry rent + tip in-transaction).
CRANK_MIN_KEEPER_BALANCE_SOL=0.05
# How many trailing rounds to rescan at boot when rebuilding the
# pending-settle queue (closed rounds vanish, ending the walk).
CRANK_MAX_TRACKED_ROUNDS=64
# Sweep + close terminal rounds past their claim deadline.
CRANK_CLEANUP_ENABLED=1
# Claim on behalf of absent winners before the deadline instead of letting
# the prize sweep to the mega-pot (pays entry.player, never the keeper).
CRANK_CLAIM_FOR_WINNERS=0
# Entries per close_entry batch transaction (Phase 11.8: every close now
# DELIVERS an 89%-pool refund to its player). 11 is the SDK's measured
# packet width (4 shared + 2 per-entry accounts); a failed batch
# auto-downgrades that round to single closes.
CRANK_CLOSE_BATCH_MAX_PER_TX=11
# A Settled round still un-pruned past this many seconds trips the health
# alert (degraded /healthz) — players are waiting on principal, not rent.
CRANK_STUCK_CLEANUP_ALERT_SECS=3600
# Log the action it WOULD take, send nothing. First-boot validation mode.
CRANK_DRY_RUN=0

# ── auto-deposit escrows (Phase 10) ──────────────────────────────────────
# Master switch for the keeper's auto-deposit cranking. Ship upgrades with
# this 0 first (design §7: crank off → update_config → verify → enable).
CRANK_AUTO_DEPOSIT_ENABLED=1
# Escrows per auto-deposit transaction. 6 is the measured default: the
# 6-batch costs ~134k CU total, inside the 200k default budget with 1.5×
# headroom (docs/reports/cu_profile.md). Range 1–12.
CRANK_AUTO_DEPOSIT_MAX_PER_TX=6
# Minimum gap between auto-deposit batch scans (entry-index retries inside
# the window are paced by the executor, not by this).
CRANK_AUTO_DEPOSIT_INTERVAL_MS=1000
# Bounded getProgramAccounts reconcile ({dataSize: 122}) at boot and every
# interval below; per-round reads are chunked getMultipleAccounts, never
# GPA. On RPC refusal the registry is kept (event feed + seed remain).
CRANK_ESCROW_GPA_ENABLED=1
CRANK_ESCROW_RECONCILE_MS=600000
# Comma-separated escrow OR owner pubkeys — manual recovery and the
# no-GPA operating mode.
CRANK_ESCROW_SEED=

# ── health endpoint ─────────────────────────────────────────────────────
# 200 while ok/starting, 503 once degraded (3+ consecutive tick errors or
# keeper balance below minimum). Loopback by default — monitor via SSH
# tunnel or bind + firewall a specific source.
CRANK_HEALTHZ_HOST=127.0.0.1
CRANK_HEALTHZ_PORT=8080

# ── persistence & logs ──────────────────────────────────────────────────
# Round-tracking state + per-round randomness keypairs live here.
CRANK_STATE_DIR=var
CRANK_LOG_LEVEL=info
# Optionally mirror JSON logs to a file (journald gets stdout regardless).
#CRANK_LOG_FILE=/var/log/orbit-crank/log.json
