# ─────────────────────────────────────────────────────────────────────────
# Raffle serverless functions — SERVER environment (Vercel Project →
# Settings → Environment Variables).
#
# NONE of these are VITE_-prefixed and none of them belong in
# apps/web/.env.example. That is rule R1, and it is enforced: a test
# fails if apps/web/.env.example so much as NAMES a SUPABASE variable,
# because the browser must never see a key — not even a key's name.
# The browser's only contact with the raffle is POSTing to
# /api/raffle/* over HTTPS.
#
# Placeholders only. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────

# ── required: the database ─────────────────────────────────────────────
# The service-role key. It bypasses RLS entirely, which is the point:
# 003_lockdown.sql grants the raffle tables to service_role and NOBODY
# else, so there is no browser-usable credential to misconfigure. Treat
# this like a root password.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── required: the chain ────────────────────────────────────────────────
# Mainnet, and a DEDICATED endpoint — every claim is a getTransaction at
# finalized commitment (R2) and the public endpoint will rate-limit you
# out of a launch. Helius / Triton / QuickNode / Alchemy.
SOLANA_RPC_URL=https://your-mainnet-rpc-endpoint/your-api-key

# ── required: the treasury ─────────────────────────────────────────────
# Where a 0.05 SOL entry purchase must land for the server to count it
# (§6.4). Transfers anywhere else earn nothing. Proceeds fund the ORB
# buyback, and every buyback signature is published per epoch (R8).
RAFFLE_TREASURY_PUBKEY=YourTreasuryWalletBase58Here

# ── required: the cron guard ───────────────────────────────────────────
# Every /api/raffle/cron/* endpoint 401s without this exact value in the
# x-cron-secret header. The same value goes into the database, which is
# where pg_cron reads it from:
#   INSERT INTO raffle_ops_config (key, value) VALUES
#     ('function_base_url', 'https://your-deployment.vercel.app'),
#     ('cron_secret',       'the-same-long-random-string')
#   ON CONFLICT (key) DO UPDATE SET value = excluded.value, updated_at = now();
# Generate with: openssl rand -hex 32
RAFFLE_CRON_SECRET=generate-a-long-random-string

# ── required before the first draw ─────────────────────────────────────
# Base58 secret key of the wallet that publishes the draw commitment as
# an on-chain memo (§6.5 step 2d). The memo's block time is what proves
# the merkle root predated the reveal slot, so without this the draw has
# no public commitment and the epoch lock fails loudly at commit time.
# Needs only enough SOL for memo fees. Keep it separate from the
# treasury.
# RAFFLE_COMMIT_KEYPAIR=base58-encoded-secret-key

# ── required for ORE entries ───────────────────────────────────────────
# The wallet the ORE tab sends its platform fee to — the web app's
# VITE_ORE_FEE_RECIPIENT, exactly. Only deploys that paid this wallet
# earn ORE entries; the raffle-ore-indexer job reads its history. Unset,
# the indexer returns 500 and no ORE deploy earns anything.
# Must differ from RAFFLE_TREASURY_PUBKEY (AUDIT R-14: the raffle refuses to start otherwise).
# RAFFLE_ORE_FEE_RECIPIENT=YourOreFeeWalletBase58Here
#
# The minimum fee a deploy must have paid. Defaults mirror the web app's
# PLATFORM_FEE (1%, 0.0001 SOL floor, 0.05 SOL ceiling); change them only
# together with it, or the page's own users stop earning.
# RAFFLE_ORE_FEE_BPS=100
# RAFFLE_ORE_FEE_MIN_LAMPORTS=100000
# RAFFLE_ORE_FEE_MAX_LAMPORTS=50000000

# ── optional: the economics (directive §3) ─────────────────────────────
# All of these have the defaults shown and are read from the environment
# rather than hard-coded, so a tuning change is a redeploy, not a patch.
# Uncomment only what you are actually changing.
#
# LAMPORTS_PER_ENTRY=1000000000        # 1 SOL earns 1 entry
# ENTRY_PRICE_LAMPORTS=50000000        # 0.05 SOL buys 1 entry
# REFERRAL_MIN_LAMPORTS=1000000000     # referee's first event must reach 1 SOL
# REFERRAL_CAP_PER_EPOCH=25            # bonus entries one referrer can earn
# PURCHASE_CAP_PER_WALLET=25           # R7, first limb
# PURCHASE_CAP_SHARE_BPS=3000          # R7, second limb: 30% of the pool
# EPOCH_CAP=1000                       # entries that end an epoch early
# EPOCH_DURATION_DAYS=7                # the other way an epoch ends
#
# Raising PURCHASE_CAP_* is the one change here that can break the
# promotion rather than tune it: at 1 000 entries × 0.05 SOL, 50 SOL buys
# an entire epoch outright. If the prize ever exceeds what the aggregate
# cap allows a single buyer to spend, the raffle is a money printer.
